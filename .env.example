# Copie este arquivo para ".env" (sem o .example) e ajuste os valores.
# O .env está no .gitignore e nunca vai para o GitHub.

# --- PostgreSQL (usado pelo docker-compose e pela aplicação) ---
POSTGRES_USER=transparencia
POSTGRES_PASSWORD=transparencia
POSTGRES_DB=transparencia
POSTGRES_PORT=5432

# URL de conexão que a aplicação Python usa.
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql+psycopg://transparencia:transparencia@localhost:5432/transparencia

# --- IA na zona cinzenta (opcional: sem ela, esses casos ficam NAO_AVALIADO) ---
# Padrão: nenhum. Medida contra o golden set, a IA local não melhorou a
# concordância com os rótulos (docs/05_avaliacao.md, seção 6).
# LLM_PROVEDOR:
#   nenhum    -> só regras determinísticas + revisão humana
#   ollama    -> modelo aberto local, gratuito (docs/01_setup_windows.md, passo 11)
#   anthropic -> Claude, pago por token; exige ANTHROPIC_API_KEY
LLM_PROVEDOR=nenhum
# Modelo usado quando LLM_PROVEDOR=ollama (ou claude-haiku-5-5 com anthropic)
LLM_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# Só para LLM_PROVEDOR=anthropic (e então LLM_MODEL=claude-haiku-5-5)
ANTHROPIC_API_KEY=
